# Copy to `.env` and fill in. `.env` is git-ignored; never commit a real key.
# The BFF reads these from the ambient environment (no dotenv loader); source the
# file before starting it, for example: `set -a; . ./.env; set +a`.

# Required. Absolute http(s) URL of the upstream phones API.
UPSTREAM_API_URL=https://example.invalid

# Required, non-empty. Provided in the challenge statement.
UPSTREAM_API_KEY=replace-me

# Optional. Upstream request timeout in milliseconds. Default 15000.
UPSTREAM_TIMEOUT_MS=15000

# Optional. Port the BFF listens on. Default 3001.
PORT=3001

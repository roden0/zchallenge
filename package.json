{
  "name": "zarachallenge",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile phone catalog web app (technical challenge)",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=18.18.0"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^10.33.4",
      "onFail": "download"
    }
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "biome check .",
    "format": "biome format --write .",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "turbo": "^2.11.8",
    "typescript": "5.9.3"
  }
}
